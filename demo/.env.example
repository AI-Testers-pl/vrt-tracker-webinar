# Copy to demo/.env (kept out of git) if you want to override the defaults below.
#
# Panel login (http://localhost:8082) is separate from the API key: the migration
# image bakes in visual-regression-tracker@example.com / 123456 regardless of any
# DEFAULT_USER_* variable. Create your own account from the panel if you need one.

VRT_APIURL=http://localhost:4200
VRT_PROJECT=VRT Webinar Demo

# Key baked into the migration image, works right after `npm run tracker:up`.
# Generate your own from the panel's user menu. Never commit a real one — <REDACTED>.
VRT_APIKEY=DEFAULTUSERAPIKEYTOBECHANGED

# true  = missing baseline / diff just print to the console, run stays green
# false = both fail the test
# Leave "true" for the first run, there is no baseline yet.
VRT_ENABLESOFTASSERT=true

# VRT_BRANCHNAME=main
